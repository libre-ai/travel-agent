{
  "name": "@libre-ai/travel-agent",
  "version": "0.1.0",
  "description": "Itinerary planner reasoning over verified, sourced facts — the model composes, the code vetoes. Trip instances never leave the traveller's machine.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "libre-ai",
    "travel",
    "itinerary",
    "open-data",
    "privacy"
  ],
  "homepage": "https://libre-ai.fr",
  "repository": {
    "type": "git",
    "url": "https://github.com/libre-ai/travel-agent.git"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "check:bun:runtime": "bun node_modules/@libre-ai/governance/tools/quality/check-bun-minimum.ts",
    "check:bun": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-bun-manifests.ts",
    "check:toolchain": "bun run check:bun && bun node_modules/@libre-ai/governance/tools/quality/check-toolchain.ts",
    "check:secret-scan": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-secret-scan.ts",
    "check:trip-isolation": "bun run check:bun:runtime && bun tools/ci/check-trip-isolation.ts",
    "lint": "bun run check:bun:runtime && biome ci .",
    "typecheck": "bun run check:bun:runtime && tsc --noEmit -p tsconfig.json",
    "pretest": "bun run check:bun",
    "test": "bun test",
    "check:local": "bun run check:bun:runtime && bun run check:trip-isolation && bun run lint && bun run typecheck && bun run test",
    "check": "bun run check:bun && bun run check:toolchain && bun run check:secret-scan && bun run check:local"
  },
  "packageManager": "bun@1.4.0-canary.1",
  "devDependencies": {
    "@libre-ai/governance": "github:libre-ai/governance#9cd1d421d318129db99456d963f4bc1cfad67b33",
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
